#!/system/bin/sh
# EasyTier Magisk CLI 智能客户端包装器
# 支持在终端直接运行 easytier-cli / easytier 查看加入的所有 peer 状态
# 自动探测单网络/多网络实例并路由到对应的 RPC 端口
# 兼容 Termux、KernelSU、APatch、Magisk 各种终端与环境

# 1. 定位模块主目录
SCRIPT_DIR=$(CDPATH= cd "${0%/*}" 2>/dev/null && pwd -P)
MODDIR=""
if [ -f "${SCRIPT_DIR}/module.prop" ]; then
    MODDIR="$SCRIPT_DIR"
elif [ -f "${SCRIPT_DIR}/../../module.prop" ]; then
    MODDIR="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
elif [ -d "/data/adb/modules/easytier_magisk" ]; then
    MODDIR="/data/adb/modules/easytier_magisk"
elif [ -d "/data/adb/modules_update/easytier_magisk" ]; then
    MODDIR="/data/adb/modules_update/easytier_magisk"
fi

if [ -z "$MODDIR" ] || [ ! -d "$MODDIR" ]; then
    echo "[EasyTier] 错误: 无法定位模块目录" >&2
    exit 1
fi

REAL_CLI="${MODDIR}/easytier-cli-bin"
if [ ! -x "$REAL_CLI" ]; then
    if [ -x "${MODDIR}/easytier-cli" ] && file "${MODDIR}/easytier-cli" 2>/dev/null | grep -q "ELF"; then
        REAL_CLI="${MODDIR}/easytier-cli"
    else
        echo "[EasyTier] 错误: 找不到底层的二进制程序: ${REAL_CLI}" >&2
        exit 1
    fi
fi

INSTANCES_FILE="${MODDIR}/.instances"
NETWORKS_DIR="${MODDIR}/config/networks"
LEGACY_CONFIG="${MODDIR}/config/config.toml"
COMMAND_ARGS="${MODDIR}/config/command_args"
MODULE_PROP="${MODDIR}/module.prop"

# 2. 如果用户显式传入了 -p / --rpc-portal，直接透传原生 CLI 执行
HAS_RPC_ARG=0
for arg in "$@"; do
    case "$arg" in
        -p|--rpc-portal|--rpc-portal=*)
            HAS_RPC_ARG=1
            break
            ;;
    esac
done

if [ "$HAS_RPC_ARG" = "1" ]; then
    exec "$REAL_CLI" "$@"
fi

# 3. 帮助与版本参数优先处理（无需 root 提权）
if [ "$#" -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
    VER=$(grep '^version=' "${MODULE_PROP}" 2>/dev/null | cut -d= -f2)
    echo "================================================================================"
    echo " EasyTier Magisk CLI 终端工具 (${VER:-最新版})"
    echo "================================================================================"
    echo "常用指令:"
    echo "  easytier-cli peer [选项]        查看所有实例加入的 Peer 节点状态 (默认命令)"
    echo "  easytier-cli route [选项]       查看所有实例的路由表信息"
    echo "  easytier-cli node [选项]        查看各实例本地节点信息"
    echo "  easytier-cli status             查看模块运行状态总览与 Peer 连接统计"
    echo ""
    echo "常用选项:"
    echo "  -i, --instance <名称>           仅查看指定网络实例 (如: default, work)"
    echo "  -o, --output <table|json>       指定输出格式 (默认: table)"
    echo "  -p, --rpc-portal <地址>         指定自定义 RPC 地址 (直接透传原生 CLI)"
    echo "  --no-trunc                      禁用列截断，显示完整信息"
    echo ""
    echo "快捷别名:"
    echo "  easytier peer                   等同于 easytier-cli peer"
    echo "  easytier status                 等同于 easytier-cli status"
    echo "  action.sh peer                  免重启现场诊断查看"
    echo "================================================================================"
    echo ""
    exec "$REAL_CLI" --help
fi

if [ "$1" = "-V" ] || [ "$1" = "--version" ]; then
    exec "$REAL_CLI" --version
fi

# 4. 若模块位于 /data/adb/ 且当前为非 root 用户（例如普通 Termux 用户），自动尝试 su 提权执行
if [ "$(id -u)" -ne 0 ]; then
    case "$MODDIR" in
        /data/adb/*)
            if command -v su >/dev/null 2>&1 || [ -x /system/bin/su ]; then
                exec su 0 /system/bin/sh "$0" "$@" 2>/dev/null \
                    || exec su -c "/system/bin/sh '$0' $(for a in "$@"; do printf '%s ' "$a"; done)" 2>/dev/null
            fi
            echo "[EasyTier] 错误: 需要 root 权限以访问 EasyTier 模块，请先执行 su" >&2
            exit 1
            ;;
    esac
fi

# 4. 解析包装器专属选项 (-i / --instance 等) 并分离全局参数与子命令
FILTER_INSTANCE=""
GLOBAL_OPTS=""
SUBCOMMAND=""
EXTRA_ARGS=""
IS_JSON=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        -i|--instance)
            shift
            if [ "$#" -gt 0 ]; then
                FILTER_INSTANCE="$1"
            fi
            ;;
        --instance=*)
            FILTER_INSTANCE="${1#*=}"
            ;;
        -o|--output)
            GLOBAL_OPTS="${GLOBAL_OPTS} $1"
            shift
            if [ "$#" -gt 0 ]; then
                GLOBAL_OPTS="${GLOBAL_OPTS} $1"
                [ "$1" = "json" ] && IS_JSON=1
            fi
            ;;
        --output=*)
            GLOBAL_OPTS="${GLOBAL_OPTS} $1"
            [ "${1#*=}" = "json" ] && IS_JSON=1
            ;;
        --no-trunc|-v|--verbose)
            GLOBAL_OPTS="${GLOBAL_OPTS} $1"
            ;;
        status|list)
            SUBCOMMAND="status"
            ;;
        peer|route|node|connector|mapped-listener|stun|peer-center|vpn-portal|proxy|acl|port-forward|whitelist|stats|logger)
            if [ -z "$SUBCOMMAND" ]; then
                SUBCOMMAND="$1"
            else
                EXTRA_ARGS="${EXTRA_ARGS} $1"
            fi
            ;;
        *)
            if [ -z "$SUBCOMMAND" ]; then
                SUBCOMMAND="$1"
            else
                EXTRA_ARGS="${EXTRA_ARGS} $1"
            fi
            ;;
    esac
    shift
done

[ -z "$SUBCOMMAND" ] && SUBCOMMAND="peer"
GLOBAL_OPTS=$(echo "$GLOBAL_OPTS" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
EXTRA_ARGS=$(echo "$EXTRA_ARGS" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

# 5. 从 toml 文件提取指定键值的辅助函数
toml_get() {
    [ -f "$1" ] || return 0
    awk -v k="$2" '
        BEGIN { IGNORECASE = 1 }
        $0 ~ "^[[:space:]]*" k "[[:space:]]*=" {
            v = $0
            sub(/^[^=]*=[[:space:]]*/, "", v)
            gsub(/["\047]/, "", v)
            sub(/[[:space:]]+$/, "", v)
            print v
            exit
        }
    ' "$1" 2>/dev/null
}

# 规范化 RPC 地址（将 0.0.0.0 / [::] / 空前缀替换为 127.0.0.1）
normalize_rpc() {
    local rpc="$1"
    local def="$2"
    [ -z "$rpc" ] && rpc="$def"
    case "$rpc" in
        0.0.0.0:*|\[::\]:*) rpc="127.0.0.1:${rpc##*:}" ;;
        :*) rpc="127.0.0.1:${rpc##*:}" ;;
    esac
    printf '%s' "$rpc"
}

# 6. 获取虚拟 IP
get_virtual_ip() {
    local dev="$1"
    local cfg="$2"
    local vip=""

    if [ -n "$dev" ] && [ "$dev" != "auto" ]; then
        vip=$(ip -o -4 addr show dev "$dev" 2>/dev/null | awk '{print $4}' | head -n1)
    fi

    if [ -z "$vip" ] && [ -f "$cfg" ]; then
        vip=$(toml_get "$cfg" ipv4)
    fi

    printf '%s' "${vip:-未分配}"
}

# 7. 收集所有配置与运行实例信息 (输出: iname\tidev\ticfg\tirpc\tpid)
collect_instances() {
    if [ -f "$INSTANCES_FILE" ] && [ -s "$INSTANCES_FILE" ]; then
        local idx=0
        while IFS="$(printf '\t')" read -r iname idev icfg irpc; do
            [ -z "$iname" ] && continue
            idx=$((idx + 1))
            if [ -z "$irpc" ]; then
                irpc=$(toml_get "$icfg" rpc_portal)
            fi
            irpc=$(normalize_rpc "$irpc" "127.0.0.1:1588$((idx - 1))")
            local pid=""
            if [ -f "${MODDIR}/.pid-${iname}" ]; then
                pid=$(cat "${MODDIR}/.pid-${iname}" 2>/dev/null | tr -d ' \r\n')
                if [ -n "$pid" ] && [ ! -d "/proc/$pid" ]; then
                    pid=""
                fi
            fi
            printf '%s\t%s\t%s\t%s\t%s\n' "$iname" "${idev:-auto}" "${icfg:-}" "$irpc" "${pid:-}"
        done < "$INSTANCES_FILE"
        return
    fi

    # 兜底：若 .instances 暂未生成，扫描配置目录
    local idx=0
    if [ -d "$NETWORKS_DIR" ] && [ -n "$(ls -1 "$NETWORKS_DIR"/*.toml 2>/dev/null)" ]; then
        for f in "$NETWORKS_DIR"/*.toml; do
            [ -f "$f" ] || continue
            idx=$((idx + 1))
            local iname
            iname=$(basename "$f" .toml | tr -c 'A-Za-z0-9_-' '_' | cut -c1-32)
            local irpc
            irpc=$(toml_get "$f" rpc_portal)
            irpc=$(normalize_rpc "$irpc" "127.0.0.1:1588$((idx - 1))")
            local idev
            idev=$(toml_get "$f" dev_name)
            [ -z "$idev" ] && idev="et$((idx - 1))"
            local pid=""
            [ -f "${MODDIR}/.pid-${iname}" ] && pid=$(cat "${MODDIR}/.pid-${iname}" 2>/dev/null | tr -d ' \r\n')
            printf '%s\t%s\t%s\t%s\t%s\n' "$iname" "$idev" "$f" "$irpc" "${pid:-}"
        done
        return
    fi

    if [ -f "$COMMAND_ARGS" ]; then
        local irpc="127.0.0.1:15888"
        local pid=""
        [ -f "${MODDIR}/.pid-default" ] && pid=$(cat "${MODDIR}/.pid-default" 2>/dev/null | tr -d ' \r\n')
        printf 'default\tet0\t%s\t%s\t%s\n' "$COMMAND_ARGS" "$irpc" "${pid:-}"
        return
    fi

    if [ -f "$LEGACY_CONFIG" ]; then
        local irpc
        irpc=$(toml_get "$LEGACY_CONFIG" rpc_portal)
        irpc=$(normalize_rpc "$irpc" "127.0.0.1:15888")
        local idev
        idev=$(toml_get "$LEGACY_CONFIG" dev_name)
        [ -z "$idev" ] && idev="et0"
        local pid=""
        [ -f "${MODDIR}/.pid-default" ] && pid=$(cat "${MODDIR}/.pid-default" 2>/dev/null | tr -d ' \r\n')
        printf 'default\t%s\t%s\t%s\t%s\n' "$idev" "$LEGACY_CONFIG" "$irpc" "${pid:-}"
        return
    fi
}

# 8. 执行 status 总览命令
if [ "$SUBCOMMAND" = "status" ]; then
    echo "================================================================================"
    echo " EasyTier 模块运行状态总览"
    echo "================================================================================"
    printf "%-12s %-8s %-18s %-18s %-8s %-10s\n" "实例名" "网卡" "虚拟 IP" "RPC 端口" "PID" "Peer 状态"
    echo "--------------------------------------------------------------------------------"

    TOTAL_INST=0
    ONLINE_INST=0

    while IFS="$(printf '\t')" read -r iname idev icfg irpc ipid; do
        [ -z "$iname" ] && continue
        TOTAL_INST=$((TOTAL_INST + 1))
        vip=$(get_virtual_ip "$idev" "$icfg")
        
        # 探测活跃度与 Peer 连接数
        peer_info="未知"
        status_flag=0
        if [ -n "$ipid" ] && [ -d "/proc/$ipid" ] 2>/dev/null; then
            status_flag=1
        elif pgrep -x easytier-core >/dev/null 2>&1; then
            status_flag=1
        fi

        if [ "$status_flag" = "1" ]; then
            peer_json=$("$REAL_CLI" -p "$irpc" -o json peer 2>/dev/null)
            if [ $? -eq 0 ] && [ -n "$peer_json" ]; then
                ONLINE_INST=$((ONLINE_INST + 1))
                # 统计 peer 节点数
                peer_cnt=$(echo "$peer_json" | grep -o '"ipv4"' 2>/dev/null | wc -l | tr -d ' ')
                [ -z "$peer_cnt" ] && peer_cnt=0
                peer_info="${peer_cnt} 个节点"
            else
                peer_info="连接中/就绪"
            fi
        else
            peer_info="未运行"
        fi

        printf "%-12s %-8s %-18s %-18s %-8s %-10s\n" "$iname" "$idev" "$vip" "$irpc" "${ipid:--}" "$peer_info"
    done <<EOF
$(collect_instances)
EOF

    echo "--------------------------------------------------------------------------------"
    echo "总计: ${ONLINE_INST}/${TOTAL_INST} 实例在线 | 查看明细: easytier-cli peer"
    echo "================================================================================"
    exit 0
fi

# 9. 执行 peer / route / node 等多实例查询
INST_LIST=$(collect_instances)
if [ -z "$INST_LIST" ]; then
    echo "[EasyTier] 未检测到任何配置好的 EasyTier 网络实例。" >&2
    echo "请检查 ${MODDIR}/config/ 目录下的配置。" >&2
    exit 1
fi

# 若指定了 -i 过滤
if [ -n "$FILTER_INSTANCE" ]; then
    FILTERED=$(echo "$INST_LIST" | awk -F'\t' -v target="$FILTER_INSTANCE" '$1 == target')
    if [ -z "$FILTERED" ]; then
        echo "[EasyTier] 未找到名为 '${FILTER_INSTANCE}' 的网络实例。" >&2
        echo "可用实例列表:" >&2
        echo "$INST_LIST" | awk -F'\t' '{print "  - " $1}' >&2
        exit 1
    fi
    INST_LIST="$FILTERED"
fi

COUNT=$(echo "$INST_LIST" | wc -l | tr -d ' ')

# 单实例且请求 JSON 输出时，直接原生无修饰输出
if [ "$COUNT" -eq 1 ] && [ "$IS_JSON" = "1" ]; then
    irpc=$(echo "$INST_LIST" | cut -f4)
    exec "$REAL_CLI" -p "$irpc" $GLOBAL_OPTS $SUBCOMMAND $EXTRA_ARGS
fi

# 遍历所有目标实例输出状态
FIRST=1
echo "$INST_LIST" | while IFS="$(printf '\t')" read -r iname idev icfg irpc ipid; do
    [ -z "$iname" ] && continue

    if [ "$IS_JSON" = "0" ]; then
        [ "$FIRST" = "0" ] && echo ""
        FIRST=0

        vip=$(get_virtual_ip "$idev" "$icfg")
        echo "================================================================================"
        echo " [EasyTier 实例: ${iname}]  网卡: ${idev}  |  虚拟IP: ${vip}  |  RPC: ${irpc}"
        echo "================================================================================"
    fi

    # 调用真实 CLI (保证选项在子命令之前)
    if ! "$REAL_CLI" -p "$irpc" $GLOBAL_OPTS $SUBCOMMAND $EXTRA_ARGS; then
        if [ "$IS_JSON" = "0" ]; then
            echo "[提示] 实例 '${iname}' (${irpc}) 暂时无法连接，可能核心尚未启动或正在重启中。"
        fi
    fi
done
